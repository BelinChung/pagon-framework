{
  "name": "belinchung/pagon-framework",
  "description": "Pagon Framework",
  "keywords": ["framework", "pagon"],
  "license": "MIT",
  "authors": [
    {
      "name": "Corrie Zhao",
      "email": "hfcorriez@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.1 <9.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "replace": {
    "pagon/framework": "0.8.*"
  },
  "scripts": {
    "test": "php -d error_reporting=-1 vendor/bin/phpunit"
  },
  "suggest": {
    "opauth/opauth": "Auth with OPAuth service provider",
    "pagon/jade": "Support Jade template engine",
    "symfony/yaml": "Support Yaml config parse and build",
    "ext-openssl": "Required for authenticated cookie and CSRF encryption",
    "ext-mbstring": "Required by the Booster middleware",
    "ext-dom": "Required for XML configuration parsing"
  },
  "autoload": {
    "psr-0": {
      "Pagon": "lib/"
    }
  }
}
